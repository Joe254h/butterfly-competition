
__pycache__/
*.pyc
*.npy
*.pth
evaluation/test_labels.csv

name: Evaluate Submission

on:
  pull_request:
    paths:
      - 'submissions/**'

permissions:
  contents: write
  pull-requests: write

jobs:
  evaluate:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repo
        uses: actions/checkout@v3
        with:
          fetch-depth: 0

      - name: Setup Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Decode hidden test labels
        env:
          TEST_LABELS_B64: ${{ secrets.TEST_LABELS_BASE64 }}
        run: |
          mkdir -p evaluation
          echo "$TEST_LABELS_B64" | base64 --decode > evaluation/test_labels.csv

      - name: Detect submission file
        id: submission
        run: |
          FILE=$(git diff --name-only --diff-filter=A origin/${{ github.base_ref }}...HEAD | grep '^submissions/' | head -n1)
          echo "file=$FILE" >> $GITHUB_OUTPUT
          echo "Detected submission: $FILE"

      - name: Run evaluation
        if: steps.submission.outputs.file != ''
        run: python evaluation/score.py "${{ steps.submission.outputs.file }}"

      - name: Update leaderboard
        if: steps.submission.outputs.file != ''
        env:
          GITHUB_ACTOR: ${{ github.actor }}
        run: python leaderboard/update.py score.json

      - name: Commit leaderboard
        if: steps.submission.outputs.file != ''
        run: |
          git config --global user.name "github-actions"
          git config --global user.email "actions@github.com"
          git add leaderboard/README.md scores.json
          git commit -m "Leaderboard update"
          git push
